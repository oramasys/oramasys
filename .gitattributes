src/tests/fixtures/graph-ownership-registry-*.json -text
# Reviewed raw bytes of the producer candidate's hardware profiles (validate_coverage_packet.py).
src/tests/fixtures/agate-hardware-profiles-172bfc3.json -text
# Vendored phylax dispatch vectors, pinned by sha256 over the file bytes.
src/tests/vectors/dispatch-permit-v1.json -text
src/tests/vectors/dispatch-events-v1.json -text
# Interop probes pinned byte for byte: the slice-2 probe by sha256, the part-3 probe by cmp in CI.
