{
  "registry_version": 1,
  "decision_refs": ["D-LG-1", "D-LG-5"],
  "rule": "One owner per fact. A field that changes what a graph computes belongs to the structural GraphSpec owned by perpetua-core. A field that only restricts who may run a graph, or how far, belongs to the policy owned by oramasys. Orama docs/v2 records the decision and this registry; it holds no runtime schema.",
  "owners": {
    "perpetua-core": "Structural schema and execution mechanics (GraphSpec, NodeSpec, EdgeSpec, graph_id, the one scheduler).",
    "oramasys": "Application graph definitions and the separately versioned GraphPolicy bound by graph_id; restrict-only.",
    "orama-system": "Normative decisions and this registry. No runtime code and no schema."
  },
  "categories": {
    "identity": "Content identity or schema version.",
    "structure": "Topology that the scheduler needs in order to run.",
    "computes": "Changes the state a graph produces. Must live in the structural GraphSpec and in graph_id.",
    "restricts": "Narrows what an otherwise valid graph may do. Never changes the computed result.",
    "binding": "Links a policy to exactly one structural graph.",
    "annotation": "Free-form frozen JSON metadata."
  },
  "invariants": [
    "Every field of a registered record appears here exactly once, with exactly one owner.",
    "A policy record may not declare a field in the computes category.",
    "A planned entry must be absent from the code until its status is changed to implemented.",
    "Changing policy never changes graph_id. Changing a computes field always does."
  ],
  "records": [
    {
      "record": "GraphSpec",
      "owner": "perpetua-core",
      "python": "perpetua_core.graph.spec:GraphSpec",
      "fields": [
        {"name": "schema_version", "category": "identity", "status": "implemented"},
        {"name": "graph_id", "category": "identity", "status": "implemented"},
        {"name": "max_steps", "category": "structure", "status": "implemented"},
        {"name": "nodes", "category": "structure", "status": "implemented"},
        {"name": "edges", "category": "structure", "status": "implemented"},
        {"name": "metadata", "category": "annotation", "status": "implemented"},
        {"name": "reducers", "category": "computes", "status": "planned", "provisional_name": true, "decision": "R3"},
        {"name": "joins", "category": "computes", "status": "planned", "provisional_name": true, "decision": "R3"}
      ]
    },
    {
      "record": "NodeSpec",
      "owner": "perpetua-core",
      "python": "perpetua_core.graph.spec:NodeSpec",
      "fields": [
        {"name": "name", "category": "structure", "status": "implemented"},
        {"name": "implementation_ref", "category": "structure", "status": "implemented"},
