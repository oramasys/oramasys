#!/usr/bin/env bash
# Thin executable — launch the oramasys FastAPI surface (orama.api.server:app).
# --app-dir src puts the src-layout package on sys.path without an install.
# Default bind host comes from orama.api.authz.resolve_bind_host (loopback
# unless ORAMA_BIND_LAN is set with a non-weak ORAMA_CONTROL_PLANE_TOKEN).
# Explicit --host is allowed, but non-loopback still requires LAN policy.
# Repeated --host flags are stripped so Uvicorn binds the last validated host.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export PYTHONPATH="${PWD}/src${PYTHONPATH:+:$PYTHONPATH}"
# Script-owned filtered Uvicorn arguments. Bash 3.2 lacks local -n.
ORAMA_NON_HOST_ARGS=()

# Reject empty/whitespace-only hosts and values that look like CLI options.
normalize_explicit_host_value() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  if [[ -z "$value" || "$value" == -* ]]; then
    return 1
  fi
  printf '%s' "$value"
}

parse_explicit_host() {
  # Last --host / --host= wins (Uvicorn/Click last-option semantics).
  local prev=""
  local host=""
  local found=0
  local arg
  for arg in "$@"; do
    if [[ "$prev" == "--host" ]]; then
      if ! host="$(normalize_explicit_host_value "$arg")"; then
        printf '%s\n' "bin/serve: --host value is empty or looks like an option" >&2
        return 1
      fi
      found=1
      prev=""
      continue
    fi
    case "$arg" in
      --host)
        prev="--host"
        ;;
      --host=*)
        if ! host="$(normalize_explicit_host_value "${arg#--host=}")"; then
          printf '%s\n' "bin/serve: --host value is empty or looks like an option" >&2
          return 1
        fi
        found=1
        prev=""
        ;;
      *)
        prev=""
        ;;
    esac
  done
  if [[ "$prev" == "--host" ]]; then
    printf '%s\n' "bin/serve: --host requires a value" >&2
    return 1
  fi
  if [[ "$found" -eq 1 ]]; then
    printf '%s\n' "$host"
    return 0
  fi
  return 1
}

collect_non_host_args() {
  # Populate the script-owned array, omitting --host / --host=* pairs.
  # macOS ships Bash 3.2, which has arrays but not Bash 4.3's local -n.
  ORAMA_NON_HOST_ARGS=()
  local prev=""
  local arg
  for arg in "$@"; do
    if [[ "$prev" == "--host" ]]; then
      prev=""
      continue
    fi
    case "$arg" in
      --host)
        prev="--host"
        continue
        ;;
      --host=*)
        continue
        ;;
    esac
    ORAMA_NON_HOST_ARGS+=("$arg")
  done
}

orama_serve_main() {
  local has_host=0
  local arg
  local HOST

  for arg in "$@"; do
    case "$arg" in
      --host|--host=*) has_host=1 ;;
    esac
  done

  if [[ "$has_host" -eq 0 ]]; then
    HOST="$("${PYTHON:-python3}" -c "from orama.api.authz import resolve_bind_host; print(resolve_bind_host())")"
  else
    if ! HOST="$(parse_explicit_host "$@")"; then
      exit 64
    fi
    export ORAMA_EXPLICIT_HOST="$HOST"
    HOST="$("${PYTHON:-python3}" -c "import os; from orama.api.authz import assert_host_allowed; print(assert_host_allowed(os.environ['ORAMA_EXPLICIT_HOST']))")"
    unset ORAMA_EXPLICIT_HOST
  fi

  export ORAMA_LISTEN_HOST="$HOST"
  collect_non_host_args "$@"
  # Bash 3.2 set -u treats a bare empty "${array[@]}" as unbound.
  # ${name[@]+...} skips that expansion when the filtered list is empty,
  # so one exec covers host-only and extra-argument launches.
  exec "${PYTHON:-python3}" -m uvicorn --app-dir src orama.api.server:app \
    --host "$HOST" "${ORAMA_NON_HOST_ARGS[@]+"${ORAMA_NON_HOST_ARGS[@]}"}"
}

if [[ "${ORAMA_SERVE_LIB:-}" != "1" ]]; then
  orama_serve_main "$@"
fi
