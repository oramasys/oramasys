#!/usr/bin/env bash
# Thin executable — launch the oramasys FastAPI surface (orama.api.server:app).
# --app-dir src puts the src-layout package on sys.path without an install.
# Default bind host comes from orama.api.authz.resolve_bind_host (loopback
# unless ORAMA_BIND_LAN is set with a non-weak ORAMA_CONTROL_PLANE_TOKEN).
# Explicit --host is allowed, but non-loopback still requires LAN policy.
# Repeated --host flags are stripped so Uvicorn binds the last validated host.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export PYTHONPATH="${PWD}/src${PYTHONPATH:+:$PYTHONPATH}"

parse_explicit_host() {
  # Last --host / --host= wins (Uvicorn/Click last-option semantics).
  local prev=""
  local host=""
  local found=0
  local arg
  for arg in "$@"; do
    if [[ "$prev" == "--host" ]]; then
      host="$arg"
      found=1
      prev=""
      continue
    fi
    case "$arg" in
      --host)
        prev="--host"
        ;;
      --host=*)
        host="${arg#--host=}"
        found=1
        prev=""
        ;;
      *)
        prev=""
        ;;
    esac
  done
  if [[ "$found" -eq 1 ]]; then
    printf '%s\n' "$host"
    return 0
  fi
  return 1
}

collect_non_host_args() {
  # Populate the script-owned array, omitting --host / --host=* pairs.
  # macOS ships Bash 3.2, which has arrays but not Bash 4.3's local -n.
  ORAMA_NON_HOST_ARGS=()
  ORAMA_NON_HOST_ARGS_COUNT=0
  local prev=""
  local arg
  for arg in "$@"; do
    if [[ "$prev" == "--host" ]]; then
      prev=""
      continue
    fi
    case "$arg" in
      --host)
        prev="--host"
        continue
        ;;
      --host=*)
        continue
        ;;
    esac
    ORAMA_NON_HOST_ARGS+=("$arg")
    ORAMA_NON_HOST_ARGS_COUNT=$((ORAMA_NON_HOST_ARGS_COUNT + 1))
  done
}

orama_serve_main() {
  local has_host=0
  local arg
  local HOST
  local -a ORAMA_NON_HOST_ARGS=()

  for arg in "$@"; do
    case "$arg" in
      --host|--host=*) has_host=1 ;;
    esac
  done

  if [[ "$has_host" -eq 0 ]]; then
    HOST="$("${PYTHON:-python3}" -c "from orama.api.authz import resolve_bind_host; print(resolve_bind_host())")"
  else
    HOST="$(parse_explicit_host "$@")"
    export ORAMA_EXPLICIT_HOST="$HOST"
    HOST="$("${PYTHON:-python3}" -c "import os; from orama.api.authz import assert_host_allowed; print(assert_host_allowed(os.environ['ORAMA_EXPLICIT_HOST']))")"
    unset ORAMA_EXPLICIT_HOST
  fi

  export ORAMA_LISTEN_HOST="$HOST"
  collect_non_host_args "$@"
  if [[ "$ORAMA_NON_HOST_ARGS_COUNT" -eq 0 ]]; then
    exec "${PYTHON:-python3}" -m uvicorn --app-dir src orama.api.server:app --host "$HOST"
  fi
  exec "${PYTHON:-python3}" -m uvicorn --app-dir src orama.api.server:app --host "$HOST" "${ORAMA_NON_HOST_ARGS[@]}"
}

if [[ "${ORAMA_SERVE_LIB:-}" != "1" ]]; then
  orama_serve_main "$@"
fi
